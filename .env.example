# ==============================================================================
# Gosmart.Health Dictionary Service (GoSmart DS) Environment Configuration
# Prefix: GOSMART_DS_
# ==============================================================================

GOSMART_DS_DEV_MODE=true

GOSMART_DS_INITIAL_ADMIN_EMAIL=admin@gosmart.health
GOSMART_DS_INITIAL_ADMIN_PASSWORD=MySecurePassword123!
GOSMART_DS_INITIAL_ADMIN_USERNAME=admin
# GOSMART_DS_FORCE_ADMIN_PASSWORD_RESET=true

# Database Connection (Neo4j)
GOSMART_DS_DB_CONNECTION_URI=bolt://localhost:7688
GOSMART_DS_DB_USER=neo4j
GOSMART_DS_DB_PASSWORD=
GOSMART_DS_DB_DATABASE=neo4j

# Default Vector Embedding & Inference LLM Configuration
GOSMART_DS_VECTOR_EMBED_PROVIDER=ollama
GOSMART_DS_VECTOR_EMBED_SERVER_URL=http://localhost:11434
GOSMART_DS_VECTOR_EMBED_MODEL=embeddinggemma-2:270m
GOSMART_DS_VECTOR_EMBED_DIMENSIONS=768

GOSMART_DS_INFERENCE_PROVIDER=ollama
GOSMART_DS_INFERENCE_SERVER_URL=http://localhost:11434
GOSMART_DS_INFERENCE_MODEL=gemma4:e2b

# Optional Cloud Gemini / Vertex AI Settings (used in production)
# GOSMART_DS_VERTEX_AI_API_KEY=your-vertex-ai-api-key
# GOSMART_DS_VERTEX_AI_LOCATION=us-central1
# GOSMART_DS_VERTEX_AI_PROJECT_ID=your-gcp-project-id
# GOSMART_DS_LLM_CONFIG_ENCRYPTION_KEY=your-fernet-passphrase

# Authentication, Sessions & Brevo Transactional Email (Registration Verification)
# GOSMART_DS_JWT_SECRET_KEY=replace-with-a-random-32-plus-char-secret
# GOSMART_DS_SESSION_COOKIE_NAME=gosmart_ds_session
# GOSMART_DS_SESSION_COOKIE_SECURE=false
# GOSMART_DS_BREVO_API_KEY=your-brevo-api-key
# GOSMART_DS_BREVO_API_URL=https://api.brevo.com/v3/smtp/email
# GOSMART_DS_BREVO_SENDER_EMAIL=no-reply@gosmart.health
# GOSMART_DS_BREVO_SENDER_NAME="GoSmart Health Dictionary Service"
# GOSMART_DS_PUBLIC_BASE_URL=http://127.0.0.1:8081
# GOSMART_DS_EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Server Network & Host Binding
GOSMART_DS_HOST=0.0.0.0
GOSMART_DS_PORT=8081
GOSMART_DS_RELOAD=true

# Logging Configuration (Industrial Strength structlog & 7-Day Auto-Rotation)
GOSMART_DS_LOG_LEVEL=INFO
GOSMART_DS_LOG_FORMAT=json
GOSMART_DS_LOG_DIR=./logs
GOSMART_DS_LOG_FILE=gosmart_ds.log
GOSMART_DS_LOG_ROTATION_DAYS=7
GOSMART_DS_LOG_BACKUP_COUNT=8
GOSMART_DS_LOG_TO_FILE=true
